-- TPlacaVehiculo 

ALTER TABLE Domiciliario ADD CONSTRAINT CK_PLACA_VALIDA 
CHECK (
    LENGTH(placaVehiculo) = 6
    AND UPPER(SUBSTR(placaVehiculo, 1, 1)) BETWEEN 'A' AND 'Z'
    AND UPPER(SUBSTR(placaVehiculo, 2, 1)) BETWEEN 'A' AND 'Z'
    AND UPPER(SUBSTR(placaVehiculo, 3, 1)) BETWEEN 'A' AND 'Z'
    AND SUBSTR(placaVehiculo, 4, 1) BETWEEN '0' AND '9'
    AND SUBSTR(placaVehiculo, 5, 1) BETWEEN '0' AND '9'
    AND SUBSTR(placaVehiculo, 6, 1) BETWEEN '0' AND '9'
);

