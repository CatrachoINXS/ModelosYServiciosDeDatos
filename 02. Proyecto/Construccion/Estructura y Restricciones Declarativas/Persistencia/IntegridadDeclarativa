/*Se debe descontar el stock de los productos de un pedido*/
CREATE OR REPLACE TRIGGER BD_AI
AFTER INSERT ON Pedido 
FOR EACH ROW
BEGIN 
    UPDATE Producto
    SET stock = stock - 1
    WHERE id = :NEW.idProducto:
END;
/

/*Debe cambiar el estado de una factura cuando cambie el estado de pago*/
CREATE OR REPLACE TRIGGER DB_AU
AFTER UPDATE OF estadoPago ON Paga
FOR EACH ROW
BEGIN
    IF :NEW.estadoPago = 'Aceptado' THEN
        UPDATE Factura
        SET estadoFactura = 'Pagada'
        WHERE id = :NEW.idFactura;

    ELSIF :NEW.estadoPago = 'Pendiente'
        UPDATE Factura
        SET estadoFactura = 'Emitida'
        WHERE id = :NEW.idFactura;

    ELSIF :NEW.estadoPago = 'Rechazado'
        UPDATE Factura
        SET estadoFactura = 'Anulado'
        WHERE id = :NEW.idFactura;
    END IF;
END;
/

/*cuando un mesero completa una atencion, se le suma al total de propina con la propina de la factura*/
CREATE OR REPLACE TRIGGER BD_AU
AFTER UPDATE OF estadoFactura ON Factura
FOR EACH ROW
BEGIN
    IF :NEW.estadoFactura = 'Pagada' AND :OLD.estadoFactura != 'Pagada' THEN
        UPDATE Mesero
        SET totalPropina = totalPropina + :NEW.propina
        WHERE id = :NEW.idMesero;
    END IF;
END;
/

/*Calcular precio de la factura*/
CREATE OR REPLACE TRIGGER DB_BI
BEFORE INSERT ON Factura
FOR EACH ROW
DECLARE
    nprecio NUMBER(20);
BEGIN
    SELECT SUM(precio) INTO nprecio
    FROM Pedido
    WHERE idFactura = :NEW.id;

    :NEW.precio := nprecio - NVL(:NEW.descuento, 0) + NVL(:NEW.propina, 0);
END;
/


